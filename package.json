    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "tsdown": "^0.23.0"
  },
  "peerDependencies": {
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^1.0.0-beta.22",
    "hono": "^4.13.8",
    "kleur": "^4.1.5",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  }
}
