{
  "name": "@suitberks/foundation",
  "version": "3.0.10",
  "description": "Shared TypeScript foundations for reusable contracts, validation, framework adapters and utilities.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suitberks/foundation.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
